# Allow diofinder to set the system clock (needed in field/AP mode where NTP
# is not available): the web UI's "set from this device" (--offset SECONDS)
# and SkySafari's :SL/:SG/:SC sync as a fallback (absolute time). Scoped to
# just this one helper script, which validates its arguments.
diofinder ALL=(root) NOPASSWD: /usr/local/bin/diofinder-set-time
