# eFinder configuration
# Lines are key:value, # for comments. Blank lines ignored.
# Reload after edits with:  sudo systemctl restart efinder
# Environment overrides:    EFINDER_<KEY> wins over this file.

# ---- Camera ----
frame_width: 960
frame_height: 760
exposure_s: 0.2
gain: 20.0

# Adaptive exposure (off by default until tuned per setup)
auto_exposure_enabled: false
auto_exposure_target_stars: 20
auto_exposure_min_s: 0.05
auto_exposure_max_s: 1.0

# Optical properties.
#
# fov_deg is the camera's horizontal field of view in degrees. Start
# with a coarse measurement; the solver self-calibrates after ~30
# successful solves and writes the converged value back here. While
# fov_calibrated is false, the solver uses fov_max_error_deg as the
# tolerance window. Once fov_calibrated is true, it tightens to
# fov_calibrated_max_error_deg, which makes solving faster and more
# robust against false positives.
fov_deg: 13.5
arcsec_per_pixel: 50.8
fov_calibrated: false
fov_calibrated_stddev: 0.05
fov_calibrated_max_error_deg: 0.1

# Distortion coefficient. 0.0 = no estimate (solver fits it per-solve).
# Updated automatically once the calibrator converges on a stable value.
distortion: 0.0

# ---- Observer location ----
# Latitude/longitude are normally set automatically when SkySafari (or
# any LX200 client) connects -- it sends :St / :Sg with its GPS-derived
# location. The values get persisted here so the next session has them
# even before a client connects. Manual override:
#   efinder-ctl polar set-latitude 44.5
latitude_deg: 0.0
longitude_deg: 0.0

# ---- Star detection (sycamore star_detect extractor) ----
detect_sigma: 9.0

# Per-frame background compensation mode:
#   row_percentile  — cheapest; 25th-percentile of cache-line-sampled pixels
#                     per row. Good for clean dark-sky frames.
#   line_median     — true per-row median; more robust to sensor row-noise,
#                     vignetting, and light-pollution gradients along rows.
#   top_hat         — morphological white top-hat (image − opening); removes
#                     2-D vignetting / sky-glow / gradients that per-row modes
#                     can't see. Requires sycamore >= 0.9.0; degrades to
#                     line_median on older wheels. Opt-in; tune
#                     detect_tophat_radius to your rig before enabling.
detect_bg_mode: row_percentile

# Structuring-element radius (pixels) for the top_hat mode.
# Must exceed the largest star radius or the opening will eat star flux.
# Typical value: 12 (≈2× a well-focused PSF on the HQ Camera + 25 mm lens).
detect_tophat_radius: 12

# Temporal background cache: median-stack recent frames into a per-row model.
# Gives sqrt(N) noise reduction and free hot-pixel rejection. Set false if
# the per-frame bookkeeping proves too costly on a very low-power setup.
bg_cache_enabled: true
bg_cache_stack: 8
bg_cache_refresh_s: 5.0
bg_cache_slew_deg: 0.5
bg_cache_max_age_s: 60.0

# ---- Solver (olive-solve tetra3-py) ----
# solver_db: bare name -> /var/lib/efinder/<name>.npz
#            absolute path -> used as-is
solver_db: default_database
fov_max_error_deg: 1.0
min_centroids: 8
solve_timeout_ms: 1500
match_threshold: 0.00001
match_radius: 0.01

# ---- Boresight offset (pixel coordinates) ----
# Updated automatically by the alignment workflow (SkySafari sync).
# Defaults are image center.
boresight_y: 380.0
boresight_x: 480.0

# ---- Comms ----
lx200_port: 4060
lx200_client_timeout_s: 10.0

# ---- CPU affinity (Pi Zero 2W: 4 cores) ----
# 0=kernel/IRQs   1=comms+webui+IMU thread (I/O bound)
# 2=solver (primary)   3=camera + solver secondary (rayon workers)
cpu_camera: 3
cpu_solver: 2
cpu_comms: 1

# ---- Diagnostics ----
# Set save_solved_frames or save_failed_frames to true to write PNG captures
# to failed_frames_dir. Files are named capture_YYYYMMDD_HHMMSS_<label>.png
# and can be replayed with tests/solve_image.py --image <path>
save_solved_frames: false
save_failed_frames: false
failed_frames_dir: /var/lib/efinder/captures
log_solve_stats_every_n: 50

# ---- Shutdown ----
shutdown_grace_s: 2.0
