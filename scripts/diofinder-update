#!/bin/bash
# diofinder in-place updater (olive branch).
# Pulls latest application code, refreshes the olive-solve and optional
# sycamore-extract wheels from their repos' GitHub releases (a wheel
# placed in vendor/wheels/ overrides the download — local testing path),
# and restarts the service.
# No cedar-detect binary or gRPC stubs are involved.
#
# Usage:
#   sudo /usr/local/bin/diofinder-update                 # latest release tag
#   sudo /usr/local/bin/diofinder-update v0.8.1          # specific tag
#   sudo /usr/local/bin/diofinder-update --ref BRANCH    # track a branch (testing)
#
# Refuses to update if the working tree has local modifications.

set -euo pipefail

DIOFINDER_DIR=/opt/diofinder
REPO=mconsidine/diofinder

# Preserved for the self-update re-exec below -- the parsing loop consumes
# the positional params, so this is the only copy of the original invocation.
ORIG_ARGS=("$@")

TARGET_VERSION="latest"
REF=""
while [ $# -gt 0 ]; do
  case "$1" in
    --ref)   REF="${2:-}"; shift 2 || { echo "--ref needs an argument" >&2; exit 1; } ;;
    --ref=*) REF="${1#*=}"; shift ;;
    *)       TARGET_VERSION="$1"; shift ;;
  esac
done

LOG() { echo "[update] $*"; }
FAIL() { echo "[update] ERROR: $*" >&2; exit 1; }

[ "$EUID" -eq 0 ] || FAIL "must run as root"

# --- Sanity + refuse to clobber local changes --------------------------------

cd "$DIOFINDER_DIR"
# Must be a git checkout (image builds that copied the tree without grafting
# git can't self-update — re-image with a build that provisions git).
if ! sudo -u diofinder git -C "$DIOFINDER_DIR" rev-parse --git-dir >/dev/null 2>&1; then
  FAIL "$DIOFINDER_DIR is not a git repository; OTA update is unavailable. Re-image with a build that provisions git."
fi
# Run the dirty-check as the repo OWNER (diofinder), not root: root touching an
# diofinder-owned repo trips git's safe.directory protection and would be
# misreported as 'local modifications'.
if ! sudo -u diofinder git -C "$DIOFINDER_DIR" diff --quiet HEAD; then
  FAIL "Local modifications in $DIOFINDER_DIR. Refusing to update. Resolve manually."
fi

# --- Fetch application code ---------------------------------------------------

LOG "Fetching latest code"
sudo -u diofinder git fetch --tags origin

if [ -n "$REF" ]; then
  # Explicit ref: a branch (tracked + fast-forwarded) or a tag/commit (detached).
  sudo -u diofinder git fetch origin "$REF" || FAIL "Could not fetch ref '$REF'"
  if sudo -u diofinder git ls-remote --heads origin "$REF" | grep -q .; then
    LOG "Checking out branch $REF"
    sudo -u diofinder git checkout -B "$REF" "origin/$REF" || FAIL "branch checkout failed"
    sudo -u diofinder git pull --ff-only origin "$REF"     || FAIL "branch fast-forward failed"
  else
    LOG "Checking out ref $REF (tag/commit)"
    sudo -u diofinder git checkout --quiet "$REF" || FAIL "checkout of '$REF' failed"
  fi
  TAG="$REF"
else
  if [ "$TARGET_VERSION" = "latest" ]; then
    TAG=$(sudo -u diofinder git tag --sort=-v:refname | head -n1)
    [ -n "$TAG" ] || FAIL "No tags found in repo"
  else
    TAG="$TARGET_VERSION"
  fi
  LOG "Updating to $TAG"
  sudo -u diofinder git checkout --quiet "$TAG"
fi

# --- Self-update guard ---------------------------------------------------------
# The checkout above may have fetched a NEWER diofinder-update than the one
# currently running ($0, resolved to /usr/local/bin/diofinder-update in the
# normal invocation path) -- e.g. this exact release added a new CLI-wrapper
# name and a new sudoers-resync step below. Without handing off, this run
# would finish using its OLD in-memory logic: it would still git-sync the new
# script/sudoers files onto disk at $DIOFINDER_DIR, but never actually
# install/resync them anywhere, because the code performing that resync is
# the stale copy already loaded. That left a real gap (v0.11.31:
# diofinder-factory-reset landed in the webui and in the checkout, but
# "command not found" on the box because the OLD update script's wrapper list
# didn't know its name yet). Re-exec into the freshly fetched script instead
# of finishing this run stale; the guard var stops a second hand-off once the
# running copy already matches (idempotent re-fetch/re-checkout is cheap).
if [ -z "${DIOFINDER_UPDATE_REEXEC:-}" ] \
   && ! cmp -s "$0" "$DIOFINDER_DIR/scripts/diofinder-update" 2>/dev/null; then
  LOG "Newer diofinder-update fetched -- handing off to it"
  export DIOFINDER_UPDATE_REEXEC=1
  exec bash "$DIOFINDER_DIR/scripts/diofinder-update" "${ORIG_ARGS[@]}"
fi

# --- Refresh Python dependencies ----------------------------------------------

LOG "Refreshing Python dependencies"
sudo -u diofinder "$DIOFINDER_DIR/venv/bin/pip" install --quiet --upgrade \
  -r "$DIOFINDER_DIR/requirements.txt"

# --- Refresh wheels ------------------------------------------------------------
# Wheels are pulled from the source repos' latest GitHub releases. A wheel
# already present in vendor/wheels/ takes precedence (local testing path).
# Failures here are non-fatal: the device keeps its installed wheels.

VENDOR_WHEELS="$DIOFINDER_DIR/vendor/wheels"
WHEEL_TMP=$(mktemp -d)
trap 'rm -rf "$WHEEL_TMP"' EXIT
# mktemp -d defaults to 0700, owned by whoever invoked this script (root, via
# sudo). The wheel is later installed by "sudo -u diofinder pip install", so
# without this the diofinder user can't even traverse into the directory to
# read the file it just downloaded -- every fresh download (not served from
# vendor/wheels/, not already-current) failed with a Permission denied on the
# downloaded .whl until this was added.
chmod 755 "$WHEEL_TMP"

# Print the download URL of the first release asset matching a glob.
# Honors OLIVE_SOLVE_TAG / SYCAMORE_TAG env pins (same variables release.yml
# uses): unset = latest release. Without pins, updating to an OLDER code tag
# still silently jumped the wheels to newest — the exact code/wheel mismatch
# class the wheel summary exists to catch.
release_wheel_url() { # repo pattern [tag]
  local api="https://api.github.com/repos/$1/releases/latest"
  [ -n "${3:-}" ] && api="https://api.github.com/repos/$1/releases/tags/$3"
  curl -fsSL "$api" \
  | python3 -c "
import fnmatch, json, sys
rel = json.load(sys.stdin)
for a in rel.get('assets', []):
    if fnmatch.fnmatch(a['name'], sys.argv[1]):
        print(a['browser_download_url'])
        break
" "$2" 2>/dev/null
}

# Per-wheel refresh outcomes, reported loudly at the end of the run. A wheel
# that silently stays stale can masquerade as an application regression (a
# pre-June olive-solve wheel under current code produced a device-wide
# no-solve that took a full bundle-replay investigation to attribute), so
# "kept the installed version" must never scroll by unnoticed.
WHEEL_SUMMARY=""

wheel_note() { # label outcome
  WHEEL_SUMMARY="${WHEEL_SUMMARY}  $1: $2\n"
}

installed_wheel_version() { # dist
  sudo -u diofinder "$DIOFINDER_DIR/venv/bin/pip" show "$1" 2>/dev/null \
    | awk '/^Version:/{print $2}'
}

install_wheel() { # label dist repo pattern [pattern...]
  local label=$1 dist=$2 repo=$3 whl url pat before after
  shift 3
  before=$(installed_wheel_version "$dist")
  for pat in "$@"; do
    whl=$(ls "$VENDOR_WHEELS"/$pat 2>/dev/null | sort -V | tail -n1 || true)
    [ -n "$whl" ] && break
  done
  if [ -z "$whl" ]; then
    local pin=""
    case "$repo" in
      *olive-solve*)      pin="${OLIVE_SOLVE_TAG:-}" ;;
      *sycamore-extract*) pin="${SYCAMORE_TAG:-}" ;;
    esac
    [ -n "$pin" ] && LOG "$label wheel pinned to $pin (env)"
    for pat in "$@"; do
      url=$(release_wheel_url "$repo" "$pat" "$pin" || true)
      [ -n "$url" ] && break
    done
    if [ -z "$url" ]; then
      LOG "WARN: no $label wheel in vendor/wheels/ or $repo releases (keeping installed version)"
      wheel_note "$label" "NOT refreshed (no wheel found / no network) — still ${before:-not installed}"
      return 0
    fi
    whl="$WHEEL_TMP/$(basename "$url")"
    if ! curl -fsSL "$url" -o "$whl"; then
      LOG "WARN: $label wheel download failed (keeping installed version)"
      wheel_note "$label" "NOT refreshed (download failed) — still ${before:-not installed}"
      return 0
    fi
  fi
  LOG "Installing $label: $(basename "$whl")"
  if sudo -u diofinder "$DIOFINDER_DIR/venv/bin/pip" install --quiet \
      --force-reinstall --no-deps "$whl"; then
    after=$(installed_wheel_version "$dist")
    if [ -n "$before" ] && [ "$after" = "$before" ]; then
      wheel_note "$label" "OK — $after (already current)"
    else
      wheel_note "$label" "OK — ${before:-none} -> ${after:-?}"
    fi
  else
    LOG "WARN: $label wheel install failed (keeping installed version)"
    wheel_note "$label" "NOT refreshed (pip install failed) — still ${before:-not installed}"
  fi
}

PYTAG=$(sudo -u diofinder "$DIOFINDER_DIR/venv/bin/python" \
  -c 'import sys; print(f"cp{sys.version_info[0]}{sys.version_info[1]}")')

install_wheel "olive-solve"      tetra3      mconsidine/olive-solve      "tetra3-*aarch64*.whl"
# Prefer a wheel for this interpreter; fall back to abi3 (sycamore >= 0.11.2
# ships a single abi3 wheel covering all Python >= 3.8)
install_wheel "sycamore-extract" star_detect mconsidine/sycamore-extract \
  "star_detect-*${PYTAG}*aarch64*.whl" "star_detect-*abi3*aarch64*.whl"

# Loud, unmissable wheel outcome — printed here AND repeated at the very end
# of the run (the tail is what the webui update page shows last).
LOG "Wheel refresh summary:"
printf "%b" "$WHEEL_SUMMARY" | while IFS= read -r line; do [ -n "$line" ] && LOG "$line"; done
case "$WHEEL_SUMMARY" in
  *"NOT refreshed"*)
    LOG "WARNING: one or more wheels were NOT refreshed. If this update was"
    LOG "         meant to pick up solver/extractor fixes, re-run it with"
    LOG "         working internet, or place wheels in $VENDOR_WHEELS/."
    ;;
esac

# --- Refresh CLI wrapper scripts in /usr/local/bin ----------------------------
# install.sh COPIES these wrappers into /usr/local/bin at image-build time (they
# are not symlinks), so OTA must re-sync them or renamed release assets / new
# flags never reach the device (e.g. diofinder-db-update pointing at an old DB
# asset name). Each is written to a temp file and atomically renamed into place
# so overwriting the *running* diofinder-update is safe (this process keeps its
# original open file).
LOG "Refreshing CLI wrapper scripts"
for s in diofinder-update diofinder-update-launcher \
         diofinder-factory-reset diofinder-factory-reset-launcher \
         diofinder-db-update diofinder-ctl diofinder-bg-setup diofinder-bg-test \
         diofinder-gadget-connect diofinder-set-time ap.sh station.sh; do
  src="$DIOFINDER_DIR/scripts/$s"
  [ -f "$src" ] || continue
  tmp=$(mktemp "/usr/local/bin/.$s.XXXXXX") || continue
  if cp "$src" "$tmp" && chmod 755 "$tmp"; then
    mv -f "$tmp" "/usr/local/bin/$s"
  else
    rm -f "$tmp"
    LOG "WARN: could not refresh /usr/local/bin/$s"
  fi
done

# --- Refresh systemd units ----------------------------------------------------
# install.sh copies these at image-build time, so (like the CLI wrappers above)
# OTA must re-sync them or unit fixes never reach an existing device — e.g. the
# webui CapabilityBoundingSet that strips CAP_SETUID/SETGID and breaks sudo.
# Tolerant of a read-only /etc (a ProtectSystem sandbox, e.g. a webui-triggered
# update): warn and continue rather than fail the whole update. daemon-reload
# only when something actually changed.
LOG "Refreshing systemd units"
units_changed=0
for u in "$DIOFINDER_DIR"/systemd/*.service; do
  [ -f "$u" ] || continue
  base=$(basename "$u")
  if ! cmp -s "$u" "/etc/systemd/system/$base" 2>/dev/null; then
    if install -m 644 "$u" "/etc/systemd/system/$base" 2>/dev/null; then
      units_changed=1
      LOG "  updated $base"
    else
      LOG "  WARN: could not refresh $base (read-only /etc?)"
    fi
  fi
done
if [ "$units_changed" = 1 ]; then
  systemctl daemon-reload || LOG "WARN: daemon-reload failed"
fi

# --- Refresh sudoers drop-ins -------------------------------------------------
# install.sh copies these at image-build time; OTA must resync them too, or a
# newly added scoped permission (e.g. diofinder-factory-reset) never reaches
# an already-deployed device even after THIS update ships the script and
# webui button that need it. Validated with visudo before install -- a
# malformed sudoers.d file breaks ALL sudo on the box, so a failed check is
# refused rather than risked. Tolerant of a read-only /etc, like the units
# refresh above.
LOG "Refreshing sudoers drop-ins"
for s in "$DIOFINDER_DIR"/etc/sudoers.d/*; do
  [ -f "$s" ] || continue
  base=$(basename "$s")
  if ! cmp -s "$s" "/etc/sudoers.d/$base" 2>/dev/null; then
    if ! visudo -cf "$s" >/dev/null 2>&1; then
      LOG "  WARN: $base failed visudo syntax check -- not installed"
      continue
    fi
    if install -m 440 "$s" "/etc/sudoers.d/$base" 2>/dev/null; then
      LOG "  updated $base"
    else
      LOG "  WARN: could not refresh $base (read-only /etc?)"
    fi
  fi
done

# --- Record version & restart -------------------------------------------------

echo "$TAG $(date -u +%Y-%m-%dT%H:%M:%SZ)" > /var/lib/diofinder/version

LOG "Restarting services"
systemctl restart diofinder.service
systemctl restart diofinder-webui.service

LOG "Update to $TAG complete"

# Shipped-default divergence report: the /etc conf persists across updates,
# so stale settings rot silently. One-shot migrations (conf_migrate, applied
# at next service start) fix old correctness-critical defaults; everything
# else is listed here so it is at least visible.
sudo -u diofinder "$DIOFINDER_DIR/venv/bin/python" - <<'PYEOF' || true
from diofinder.conf_migrate import diff_from_default, pending_migrations
pend = pending_migrations()
if pend:
    print("conf migrations pending (applied at next service start):")
    for key, cur, new, reason in pend:
        print(f"  {key}: {cur if cur is not None else '<absent>'} -> {new}")
diffs = diff_from_default()
if diffs:
    print(f"settings differing from shipped defaults ({len(diffs)}):")
    for key, cur, dflt in diffs[:40]:
        print(f"  {key}: {cur}   (default: {dflt})")
PYEOF
# Repeat the wheel outcome as the final lines — the tail of this log is what
# the webui update page (and a scrolled-back terminal) shows last.
if [ -n "$WHEEL_SUMMARY" ]; then
  LOG "Wheel refresh summary:"
  printf "%b" "$WHEEL_SUMMARY" | while IFS= read -r line; do [ -n "$line" ] && LOG "$line"; done
  case "$WHEEL_SUMMARY" in
    *"NOT refreshed"*) LOG "WARNING: one or more wheels were NOT refreshed (see above)." ;;
  esac
fi
