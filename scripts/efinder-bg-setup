#!/usr/bin/env python3
"""
efinder-bg-setup: check and configure background compensation on a running eFinder.

Usage:
  efinder-bg-setup                          # show current background settings
  efinder-bg-setup set <mode>               # set bg mode (row_percentile | line_median | top_hat)
  efinder-bg-setup set <mode> --radius N    # set top_hat mode with radius N (default 12)
  efinder-bg-setup set <mode> --persist     # also write to efinder.conf

Modes:
  row_percentile   Cheapest; works well on dark-sky frames with mild vignetting.
  line_median      Per-row median; more robust to row-noise and brightness gradients.
  top_hat          Morphological white top-hat; removes 2-D vignetting / sky-glow.
                   Requires sycamore >= 0.9.0; degrades to line_median on older wheels.

Examples:
  efinder-bg-setup                          # show current mode
  efinder-bg-setup set top_hat --radius 14  # enable top-hat with radius 14
  efinder-bg-setup set row_percentile       # revert to default
  efinder-bg-setup set top_hat --persist    # persist to efinder.conf
"""

import argparse
import json
import sys

sys.path.insert(0, "/opt/efinder")
try:
    from efinder.maint import call as maint_call
except ImportError:
    sys.path.insert(0, ".")
    from efinder.maint import call as maint_call


VALID_MODES = ("row_percentile", "line_median", "top_hat")


def show(args):
    r = maint_call("solver_params_get")
    if not r.ok:
        print(f"ERROR: {r.error}", file=sys.stderr)
        return 1
    res = r.result or {}
    mode = res.get("detect_bg_mode", "(unknown)")
    radius = res.get("detect_tophat_radius", "(unknown)")
    print(f"detect_bg_mode:       {mode}")
    print(f"detect_tophat_radius: {radius}")
    return 0


def set_mode(args):
    mode = args.mode
    if mode not in VALID_MODES:
        print(f"ERROR: unknown mode {mode!r}; valid: {VALID_MODES}", file=sys.stderr)
        return 1

    params = {"detect_bg_mode": mode, "persist": args.persist}
    if mode == "top_hat":
        params["detect_tophat_radius"] = args.radius

    r = maint_call("solver_params_set", params)
    if not r.ok:
        print(f"ERROR: {r.error}", file=sys.stderr)
        return 1
    print(json.dumps(r.result, indent=2, default=str, sort_keys=True))
    return 0


def main():
    p = argparse.ArgumentParser(
        description="Check and configure eFinder background compensation.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    sub = p.add_subparsers(dest="cmd")
    sub.add_parser("show", help="Show current background settings (default)")

    p_set = sub.add_parser("set", help="Change background mode")
    p_set.add_argument("mode", choices=VALID_MODES)
    p_set.add_argument("--radius", type=int, default=12,
                       help="Top-hat structuring-element radius in pixels (default 12)")
    p_set.add_argument("--persist", action="store_true",
                       help="Write the new value to efinder.conf")

    args = p.parse_args()

    try:
        if args.cmd == "set":
            return set_mode(args)
        return show(args)  # default: show
    except FileNotFoundError:
        print("ERROR: maintenance socket not found. Is efinder running?",
              file=sys.stderr)
        return 2
    except PermissionError:
        print("ERROR: cannot access socket. Are you in the 'efinder' group?",
              file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main() or 0)
