#!/opt/efinder/venv/bin/python
"""
Standalone detect+solve diagnostic.

Loads a single PNG, runs cedar-detect then tetra3, and prints detailed
results.  Lets you rapidly iterate on FOV / sigma / tolerance values
without starting the full efinder daemon.

Must be run from /opt/efinder (so that tetra3 can find the star database)
and cedar-detect must be running (systemctl start cedar-detect).

Usage examples:
  cd /opt/efinder
  sudo ./scripts/efinder-solve-test /home/efinder/polaris.png
  sudo ./scripts/efinder-solve-test /home/efinder/polaris.png --fov 13.5 --fov-error 2.0
  sudo ./scripts/efinder-solve-test /home/efinder/polaris.png --sigma 5.0 --timeout 3000
"""

import argparse
import pathlib
import sys
import time

# Make both the proto stubs and the efinder package importable without
# installing anything extra.
_root = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(_root))
sys.path.insert(0, str(_root / "proto"))


def _ra_hms(ra_deg):
    h = ra_deg / 15.0
    hh = int(h)
    mm = int((h - hh) * 60)
    ss = ((h - hh) * 60 - mm) * 60
    return f"{hh:02d}h {mm:02d}m {ss:05.2f}s"


def _dec_dms(dec_deg):
    sign = "+" if dec_deg >= 0 else "-"
    d = abs(dec_deg)
    dd = int(d)
    mm = int((d - dd) * 60)
    ss = ((d - dd) * 60 - mm) * 60
    return f"{sign}{dd:02d}° {mm:02d}' {ss:04.1f}\""


def main():
    from efinder.config import load_config
    cfg = load_config()

    p = argparse.ArgumentParser(
        description="Standalone cedar-detect + tetra3 diagnostic")
    p.add_argument("image", help="Path to PNG image")
    p.add_argument("--fov", type=float, default=cfg.fov_deg,
                   help=f"FOV estimate in degrees (default: {cfg.fov_deg})")
    p.add_argument("--fov-error", type=float, default=cfg.fov_max_error_deg,
                   help=f"FOV tolerance ± degrees (default: {cfg.fov_max_error_deg})")
    p.add_argument("--sigma", type=float, default=cfg.detect_sigma,
                   help=f"Cedar-detect star threshold sigma (default: {cfg.detect_sigma})")
    p.add_argument("--min-stars", type=int, default=cfg.min_centroids,
                   help=f"Minimum stars to attempt a solve (default: {cfg.min_centroids})")
    p.add_argument("--timeout", type=int, default=cfg.solve_timeout_ms,
                   help=f"Tetra3 solve timeout ms (default: {cfg.solve_timeout_ms})")
    p.add_argument("--match-radius", type=float, default=cfg.match_radius,
                   help=f"Centroid match radius as fraction of FOV (default: {cfg.match_radius})")
    p.add_argument("--db", default=cfg.tetra3_db,
                   help=f"Tetra3 database name (default: {cfg.tetra3_db})")
    p.add_argument("--width", type=int, default=None,
                   help="Override frame width (default: image actual width)")
    p.add_argument("--height", type=int, default=None,
                   help="Override frame height (default: image actual height)")
    args = p.parse_args()

    # ---- Load image --------------------------------------------------------
    try:
        from PIL import Image as PILImage
    except ImportError:
        sys.exit("Pillow not found. Run: pip install Pillow")
    import numpy as np

    img_path = pathlib.Path(args.image)
    if not img_path.exists():
        sys.exit(f"Image not found: {img_path}")

    img = PILImage.open(img_path).convert("L")
    frame_w = args.width or img.width
    frame_h = args.height or img.height
    if (frame_w, frame_h) != (img.width, img.height):
        print(f"Resizing {img.width}x{img.height} -> {frame_w}x{frame_h}")
        img = img.resize((frame_w, frame_h), PILImage.LANCZOS)
    arr = np.array(img, dtype=np.uint8)

    peak_pixel = int(arr.max())
    print(f"Image : {img_path.name}  ({frame_w}x{frame_h})  peak={peak_pixel}")
    print(f"Params: fov={args.fov}° ±{args.fov_error}°  "
          f"sigma={args.sigma}  min-stars={args.min_stars}  "
          f"timeout={args.timeout}ms  match-radius={args.match_radius}")
    print()

    if peak_pixel < 20:
        print("WARNING: brightest pixel is < 20 ADU — image looks empty or very dark.")

    # ---- Cedar-detect ------------------------------------------------------
    try:
        import grpc
        import cedar_detect_pb2 as pb
        import cedar_detect_pb2_grpc as pb_grpc
    except ImportError as e:
        sys.exit(f"gRPC stubs not importable: {e}")

    channel = grpc.insecure_channel(cfg.cedar_detect_socket)
    stub = pb_grpc.CedarDetectStub(channel)

    req = pb.CentroidsRequest(
        input_image=pb.Image(
            width=frame_w,
            height=frame_h,
            image_data=arr.tobytes(),
        ),
        sigma=args.sigma,
        detect_hot_pixels=cfg.detect_hot_pixels,
        use_binned_for_star_candidates=cfg.detect_use_binned,
        return_binned=False,
    )

    t0 = time.monotonic()
    try:
        resp = stub.ExtractCentroids(req, timeout=5.0)
    except Exception as e:
        sys.exit(f"cedar-detect call failed: {e}\n"
                 "Is cedar-detect running?  Try: sudo systemctl start cedar-detect")
    detect_ms = (time.monotonic() - t0) * 1000

    n = len(resp.star_candidates)
    print(f"Cedar-detect : {n} stars  "
          f"peak={resp.peak_star_pixel}  noise={resp.noise_estimate:.1f}  "
          f"({detect_ms:.0f} ms)")

    if n > 0:
        by_brightness = sorted(resp.star_candidates, key=lambda c: -c.brightness)
        print(f"  Top stars (x, y, brightness):")
        for c in by_brightness[:8]:
            print(f"    ({c.centroid_position.x:7.2f}, {c.centroid_position.y:7.2f})"
                  f"  b={c.brightness:.0f}")

    print()

    if n < args.min_stars:
        print(f"Too few stars ({n} < {args.min_stars}) — skipping solve.")
        print("Suggestions:")
        print(f"  Lower --sigma (currently {args.sigma}, try 5.0 or lower)")
        print(f"  Lower --min-stars (currently {args.min_stars}, try 4 or 5)")
        return

    # ---- Tetra3 ------------------------------------------------------------
    try:
        import tetra3
    except ImportError as e:
        sys.exit(f"tetra3/cedar-solve not importable: {e}")

    print(f"Loading database: {args.db} ...")
    t3 = tetra3.Tetra3(args.db)

    centroids = np.array(
        [[c.centroid_position.y, c.centroid_position.x]
         for c in resp.star_candidates],
        dtype=np.float32,
    )

    t0 = time.monotonic()
    soln = t3.solve_from_centroids(
        centroids,
        (frame_h, frame_w),
        fov_estimate=args.fov,
        fov_max_error=args.fov_error,
        solve_timeout=args.timeout,
        match_threshold=cfg.match_threshold,
        match_radius=args.match_radius,
        distortion=cfg.distortion,
    )
    solve_ms = (time.monotonic() - t0) * 1000

    STATUS = {1: "MATCH_FOUND", 2: "NO_MATCH", 3: "TIMEOUT", 4: "CANCELLED", 5: "TOO_FEW"}
    status = soln.get("status")
    print(f"Tetra3       : {STATUS.get(status, status)}  ({solve_ms:.0f} ms)")

    if status == 1:
        ra  = soln["RA"]
        dec = soln["Dec"]
        print(f"  RA      = {ra:.5f}°  ({_ra_hms(ra)})")
        print(f"  Dec     = {dec:.5f}°  ({_dec_dms(dec)})")
        print(f"  Roll    = {soln.get('Roll', 0.0):.2f}°")
        print(f"  FOV     = {soln.get('FOV', args.fov):.4f}°")
        print(f"  Matches = {soln.get('Matches', '?')}")
    elif status == 3:
        print("  Timed out. Try: --timeout 5000  or narrow --fov-error")
    elif status == 2:
        print("  No match found. Suggestions:")
        print(f"  - Check --fov is roughly correct (currently {args.fov}°)")
        print(f"  - Widen --fov-error (currently ±{args.fov_error}°, try 3.0 or 5.0)")
        print(f"  - Lower --sigma to detect more stars (currently {args.sigma})")
        print(f"  - Increase --timeout (currently {args.timeout}ms)")


if __name__ == "__main__":
    main()
