#!/usr/bin/env python3
"""
diofinder-ctl: control and inspect a running diofinder daemon.

Usage:
  diofinder-ctl status
  diofinder-ctl version
  diofinder-ctl ping

  diofinder-ctl boresight show
  diofinder-ctl boresight center
  diofinder-ctl boresight set Y X

  diofinder-ctl calibration status
  diofinder-ctl calibration reset

  diofinder-ctl exposure get
  diofinder-ctl exposure set SECONDS [--persist]
  diofinder-ctl gain set GAIN [--persist]

  diofinder-ctl seeing get
  diofinder-ctl seeing set {good|bad}
  diofinder-ctl seeing apply-override {good|bad}
  diofinder-ctl seeing save-override [good|bad]
  diofinder-ctl seeing clear-override [good|bad]

  diofinder-ctl auto-tune start [--mode good|bad] [--commit] [--wait]
  diofinder-ctl auto-tune status
  diofinder-ctl auto-tune cancel

  diofinder-ctl raw '{"cmd":"...","args":{...}}'

Talks to /run/diofinder/maint.sock. You need to be a member of the
'diofinder' group (or root) to use this. Add yourself with:
  sudo usermod -a -G diofinder $USER
then log out and back in.
"""

import argparse
import json
import sys

# Allow running from a development checkout without an install
sys.path.insert(0, "/opt/diofinder")
try:
    from diofinder.maint import call as maint_call
except ImportError:
    sys.path.insert(0, ".")
    from diofinder.maint import call as maint_call


def _print_result(resp):
    """Pretty-print a MaintResponse."""
    if not resp.ok:
        print(f"ERROR: {resp.error}", file=sys.stderr)
        return 1
    if resp.result is None:
        print("ok")
    elif isinstance(resp.result, dict):
        print(json.dumps(resp.result, indent=2, default=str, sort_keys=True))
    else:
        print(resp.result)
    return 0


def cmd_simple(name, args, parser):
    """Run a no-arg command and print the result."""
    return _print_result(maint_call(name))


def cmd_boresight(args, parser):
    if args.action == "show":
        return _print_result(maint_call("boresight_show"))
    if args.action == "center":
        return _print_result(maint_call("boresight_center"))
    if args.action == "set":
        if args.y is None or args.x is None:
            parser.error("boresight set requires Y and X")
        return _print_result(maint_call(
            "boresight_set", {"y": args.y, "x": args.x}))


def cmd_calibration(args, parser):
    if args.action == "status":
        return _print_result(maint_call("calibration_status"))
    if args.action == "reset":
        # Confirm interactively to avoid an "oh no" moment
        if not args.yes:
            ans = input("Reset FOV calibration and discard committed values? [y/N] ")
            if ans.strip().lower() not in ("y", "yes"):
                print("aborted")
                return 1
        return _print_result(maint_call("calibration_reset"))


def cmd_exposure(args, parser):
    if args.action == "get":
        return _print_result(maint_call("exposure_get"))
    if args.action == "set":
        if args.seconds is None:
            parser.error("exposure set requires SECONDS")
        return _print_result(maint_call(
            "exposure_set",
            {"exposure_s": args.seconds, "persist": args.persist}))


def cmd_gain(args, parser):
    if args.action == "set":
        if args.gain is None:
            parser.error("gain set requires GAIN")
        return _print_result(maint_call(
            "gain_set", {"gain": args.gain, "persist": args.persist}))


def cmd_polar(args, parser):
    if args.action == "start":
        return _print_result(maint_call("polar_start"))
    if args.action == "status":
        return _print_result(maint_call("polar_status"))
    if args.action == "cancel":
        return _print_result(maint_call("polar_cancel"))
    if args.action == "set-latitude":
        if args.latitude is None:
            parser.error("polar set-latitude requires LATITUDE in degrees")
        return _print_result(maint_call(
            "polar_set_latitude",
            {"latitude_deg": args.latitude,
             "persist": not args.no_persist}))


def cmd_seeing(args, parser):
    if args.action == "get":
        return _print_result(maint_call("seeing_get"))
    if args.action == "set":
        if args.mode not in ("good", "bad"):
            parser.error("seeing set requires MODE 'good' or 'bad'")
        return _print_result(maint_call("seeing_set", {"mode": args.mode}))
    if args.action == "apply-override":
        if args.mode not in ("good", "bad"):
            parser.error("seeing apply-override requires MODE 'good' or 'bad'")
        return _print_result(maint_call(
            "seeing_set", {"mode": args.mode, "use_override": True}))
    if args.action in ("save-override", "clear-override"):
        call_args = {}
        if args.mode in ("good", "bad"):
            call_args["mode"] = args.mode
        cmd = ("seeing_override_save" if args.action == "save-override"
               else "seeing_override_clear")
        return _print_result(maint_call(cmd, call_args))


def cmd_autotune(args, parser):
    if args.action == "status":
        return _print_result(maint_call("auto_tune_status"))
    if args.action == "cancel":
        return _print_result(maint_call("auto_tune_cancel"))
    if args.action == "start":
        call_args = {"commit": bool(args.commit)}
        if args.mode:
            call_args["mode"] = args.mode
        if args.frames is not None:
            call_args["frames_per_point"] = args.frames
        if args.budget is not None:
            call_args["time_budget_s"] = args.budget
        if args.rate is not None:
            call_args["match_rate_floor"] = args.rate
        resp = maint_call("auto_tune", call_args)
        if not resp.ok or not args.wait:
            return _print_result(resp)
        # Poll to completion, printing phase/progress transitions.
        import time
        last = None
        while True:
            time.sleep(2.0)
            st = maint_call("auto_tune_status")
            if not st.ok:
                return _print_result(st)
            res = st.result or {}
            line = f"{res.get('phase')}: {res.get('message')}"
            if line != last:
                print(line, file=sys.stderr)
                last = line
            if not res.get("running"):
                return _print_result(
                    maint_call("auto_tune_status"))


def cmd_raw(args, parser):
    try:
        obj = json.loads(args.json)
    except json.JSONDecodeError as e:
        parser.error(f"bad JSON: {e}")
    return _print_result(maint_call(
        cmd=obj.get("cmd", ""), args=obj.get("args") or {}))


def main():
    parser = argparse.ArgumentParser(
        description="Control and inspect a running diofinder daemon.")
    sub = parser.add_subparsers(dest="cmd", required=True)

    sub.add_parser("ping", help="Check the daemon is responsive")
    sub.add_parser("version", help="Show daemon version")
    sub.add_parser("status", help="Show current solution and config summary")

    p_bs = sub.add_parser("boresight", help="Manage the boresight pixel")
    p_bs.add_argument("action", choices=["show", "center", "set"])
    p_bs.add_argument("y", nargs="?", type=float, default=None)
    p_bs.add_argument("x", nargs="?", type=float, default=None)

    p_cal = sub.add_parser("calibration", help="Inspect or reset FOV calibration")
    p_cal.add_argument("action", choices=["status", "reset"])
    p_cal.add_argument("-y", "--yes", action="store_true",
                       help="Skip confirmation prompt for reset")

    p_exp = sub.add_parser("exposure", help="Read or change exposure")
    p_exp.add_argument("action", choices=["get", "set"])
    p_exp.add_argument("seconds", nargs="?", type=float, default=None)
    p_exp.add_argument("--persist", action="store_true",
                       help="Save the new value to diofinder.conf")

    p_g = sub.add_parser("gain", help="Change camera gain")
    p_g.add_argument("action", choices=["set"])
    p_g.add_argument("gain", nargs="?", type=float, default=None)
    p_g.add_argument("--persist", action="store_true",
                     help="Save the new value to diofinder.conf")

    p_pol = sub.add_parser("polar", help="Polar alignment workflow")
    p_pol.add_argument("action", choices=["start", "status", "cancel",
                                          "set-latitude"])
    p_pol.add_argument("latitude", nargs="?", type=float, default=None,
                       help="Latitude in degrees (for set-latitude)")
    p_pol.add_argument("--no-persist", action="store_true",
                       help="Don't write the latitude back to diofinder.conf")

    p_see = sub.add_parser("seeing", help="Good/Bad seeing preset + overrides")
    p_see.add_argument("action", choices=["get", "set", "apply-override",
                                          "save-override", "clear-override"])
    p_see.add_argument("mode", nargs="?", choices=["good", "bad"], default=None,
                       help="Mode for set / *-override (defaults to current)")

    p_at = sub.add_parser("auto-tune",
                          help="Offline detection/exposure tuning sweep")
    p_at.add_argument("action", choices=["start", "status", "cancel"])
    p_at.add_argument("--mode", choices=["good", "bad"], default=None,
                      help="Seeing preset to tune toward (default: current)")
    p_at.add_argument("--commit", action="store_true",
                      help="Persist the discovered settings (else dry run)")
    p_at.add_argument("--frames", type=int, default=None,
                      help="Frames evaluated per candidate (2-15, default 3)")
    p_at.add_argument("--budget", type=float, default=None,
                      help="Time budget in seconds (20-600, default 180)")
    p_at.add_argument("--rate", type=float, default=None,
                      help="Required match rate, 0-1 (default 0.6)")
    p_at.add_argument("--wait", action="store_true",
                      help="Poll until the sweep finishes, then print result")

    p_raw = sub.add_parser("raw", help="Send a raw JSON request")
    p_raw.add_argument("json", help='e.g. \'{"cmd":"status","args":{}}\'')

    args = parser.parse_args()

    handlers = {
        "ping": lambda a, p: cmd_simple("ping", a, p),
        "version": lambda a, p: cmd_simple("version", a, p),
        "status": lambda a, p: cmd_simple("status", a, p),
        "boresight": cmd_boresight,
        "calibration": cmd_calibration,
        "exposure": cmd_exposure,
        "gain": cmd_gain,
        "seeing": cmd_seeing,
        "auto-tune": cmd_autotune,
        "raw": cmd_raw,
    }
    try:
        return handlers[args.cmd](args, parser)
    except FileNotFoundError:
        print("ERROR: maintenance socket not found.\n"
              "Is the diofinder service running? Try:\n"
              "  systemctl status diofinder",
              file=sys.stderr)
        return 2
    except PermissionError:
        print("ERROR: cannot access maintenance socket.\n"
              "Make sure you're in the 'diofinder' group:\n"
              "  sudo usermod -a -G diofinder $USER\n"
              "then log out and back in.",
              file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main() or 0)
