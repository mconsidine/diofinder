#!/bin/bash
# eFinder in-place updater (olive branch).
# Pulls latest application code, refreshes the olive-solve and optional
# sycamore-extract wheels from vendor/wheels/, and restarts the service.
# No cedar-detect binary or gRPC stubs are involved.
#
# Usage:
#   sudo /usr/local/bin/efinder-update                 # latest release tag
#   sudo /usr/local/bin/efinder-update v0.8.1          # specific tag
#   sudo /usr/local/bin/efinder-update --ref BRANCH    # track a branch (testing)
#
# Refuses to update if the working tree has local modifications.

set -euo pipefail

EFINDER_DIR=/opt/efinder
REPO=mconsidine/diofinder

TARGET_VERSION="latest"
REF=""
while [ $# -gt 0 ]; do
  case "$1" in
    --ref)   REF="${2:-}"; shift 2 || { echo "--ref needs an argument" >&2; exit 1; } ;;
    --ref=*) REF="${1#*=}"; shift ;;
    *)       TARGET_VERSION="$1"; shift ;;
  esac
done

LOG() { echo "[update] $*"; }
FAIL() { echo "[update] ERROR: $*" >&2; exit 1; }

[ "$EUID" -eq 0 ] || FAIL "must run as root"

# --- Sanity + refuse to clobber local changes --------------------------------

cd "$EFINDER_DIR"
# Must be a git checkout (image builds that copied the tree without grafting
# git can't self-update — re-image with a build that provisions git).
if ! sudo -u efinder git -C "$EFINDER_DIR" rev-parse --git-dir >/dev/null 2>&1; then
  FAIL "$EFINDER_DIR is not a git repository; OTA update is unavailable. Re-image with a build that provisions git."
fi
# Run the dirty-check as the repo OWNER (efinder), not root: root touching an
# efinder-owned repo trips git's safe.directory protection and would be
# misreported as 'local modifications'.
if ! sudo -u efinder git -C "$EFINDER_DIR" diff --quiet HEAD; then
  FAIL "Local modifications in $EFINDER_DIR. Refusing to update. Resolve manually."
fi

# --- Fetch application code ---------------------------------------------------

LOG "Fetching latest code"
sudo -u efinder git fetch --tags origin

if [ -n "$REF" ]; then
  # Explicit ref: a branch (tracked + fast-forwarded) or a tag/commit (detached).
  sudo -u efinder git fetch origin "$REF" || FAIL "Could not fetch ref '$REF'"
  if sudo -u efinder git ls-remote --heads origin "$REF" | grep -q .; then
    LOG "Checking out branch $REF"
    sudo -u efinder git checkout -B "$REF" "origin/$REF" || FAIL "branch checkout failed"
    sudo -u efinder git pull --ff-only origin "$REF"     || FAIL "branch fast-forward failed"
  else
    LOG "Checking out ref $REF (tag/commit)"
    sudo -u efinder git checkout --quiet "$REF" || FAIL "checkout of '$REF' failed"
  fi
  TAG="$REF"
else
  if [ "$TARGET_VERSION" = "latest" ]; then
    TAG=$(sudo -u efinder git tag --sort=-v:refname | head -n1)
    [ -n "$TAG" ] || FAIL "No tags found in repo"
  else
    TAG="$TARGET_VERSION"
  fi
  LOG "Updating to $TAG"
  sudo -u efinder git checkout --quiet "$TAG"
fi

# --- Refresh Python dependencies ----------------------------------------------

LOG "Refreshing Python dependencies"
sudo -u efinder "$EFINDER_DIR/venv/bin/pip" install --quiet --upgrade \
  -r "$EFINDER_DIR/requirements.txt"

# --- Install olive-solve wheel ------------------------------------------------

VENDOR_WHEELS="$EFINDER_DIR/vendor/wheels"
OLIVE_WHL=$(ls "$VENDOR_WHEELS"/tetra3-*.whl 2>/dev/null | sort -V | tail -n1)

if [ -n "$OLIVE_WHL" ]; then
  LOG "Installing olive-solve: $(basename "$OLIVE_WHL")"
  sudo -u efinder "$EFINDER_DIR/venv/bin/pip" install --quiet \
    --force-reinstall --no-deps "$OLIVE_WHL" \
    || FAIL "olive-solve wheel install failed"
else
  FAIL "No olive-solve (tetra3) wheel found in $VENDOR_WHEELS. Run the 'Vendor Binaries' workflow."
fi

# --- Install sycamore-extract wheel (optional) --------------------------------

SYCAMORE_WHL=$(ls "$VENDOR_WHEELS"/star_detect-*.whl 2>/dev/null | sort -V | tail -n1)
if [ -n "$SYCAMORE_WHL" ]; then
  LOG "Installing sycamore-extract: $(basename "$SYCAMORE_WHL")"
  sudo -u efinder "$EFINDER_DIR/venv/bin/pip" install --quiet \
    --force-reinstall --no-deps "$SYCAMORE_WHL" \
    || LOG "WARN: sycamore-extract install failed (non-fatal; olive backend will be used)"
fi

# --- Record version & restart -------------------------------------------------

echo "$TAG $(date -u +%Y-%m-%dT%H:%M:%SZ)" > /var/lib/efinder/version

LOG "Restarting services"
systemctl restart efinder.service
systemctl restart efinder-webui.service

LOG "Update to $TAG complete"
