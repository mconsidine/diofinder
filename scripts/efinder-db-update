#!/bin/bash
# eFinder solver-database updater.
# Downloads the cedar_solve_13deg.npz star database published on
# mconsidine/astro_databases releases, verifies its SHA-256 against the
# release manifest, installs it over the database named by solver_db in
# /etc/efinder/efinder.conf (backing up the old one), and restarts the
# service. The database is built from the merged Gaia DR3 + Hipparcos
# catalog (63k stars to G=8); olive-solve loads it directly.
#
# Usage:
#   sudo /usr/local/bin/efinder-db-update            # latest release
#   sudo /usr/local/bin/efinder-db-update v2026.06   # specific tag

set -euo pipefail

REPO=mconsidine/astro_databases
ASSET=cedar_solve_13deg.npz
CONF=/etc/efinder/efinder.conf
TAG="${1:-latest}"

LOG() { echo "[db-update] $*"; }
FAIL() { echo "[db-update] ERROR: $*" >&2; exit 1; }

[ "$EUID" -eq 0 ] || FAIL "must run as root"

if [ "$TAG" = "latest" ]; then
  BASE="https://github.com/$REPO/releases/latest/download"
else
  BASE="https://github.com/$REPO/releases/download/$TAG"
fi

# Resolve the installed database path the same way the solver does:
# bare solver_db names live under /var/lib/efinder/<name>.npz.
DB_STEM=$(awk -F': *' '$1=="solver_db"{v=$2} END{print v}' "$CONF" 2>/dev/null || true)
DB_STEM="${DB_STEM:-default_database}"
case "$DB_STEM" in
  /*) DB_PATH="$DB_STEM" ;;
  *)  DB_PATH="/var/lib/efinder/${DB_STEM}.npz" ;;
esac

TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT

LOG "Downloading $ASSET ($TAG) from $REPO..."
curl -fsSL "$BASE/$ASSET" -o "$TMPDIR/$ASSET" \
  || FAIL "download failed: $BASE/$ASSET"

LOG "Verifying SHA-256 against release manifest..."
if curl -fsSL "$BASE/manifest.json" -o "$TMPDIR/manifest.json"; then
  WANT=$(python3 -c "
import json, sys
m = json.load(open('$TMPDIR/manifest.json'))
print(m['outputs']['cedar_solve']['sha256'])
" 2>/dev/null) || WANT=""
  if [ -n "$WANT" ]; then
    GOT=$(sha256sum "$TMPDIR/$ASSET" | cut -d' ' -f1)
    [ "$GOT" = "$WANT" ] || FAIL "SHA-256 mismatch (got $GOT, manifest says $WANT)"
    LOG "SHA-256 OK ($GOT)"
  else
    LOG "WARNING: manifest has no cedar_solve hash; skipping verification"
  fi
else
  LOG "WARNING: no manifest.json on release; skipping verification"
fi

if [ -f "$DB_PATH" ]; then
  LOG "Backing up $DB_PATH -> $DB_PATH.bak"
  cp -f "$DB_PATH" "$DB_PATH.bak"
fi

install -m 644 -o efinder -g efinder "$TMPDIR/$ASSET" "$DB_PATH"
LOG "Installed $(du -h "$DB_PATH" | cut -f1) database at $DB_PATH"

LOG "Restarting efinder service..."
systemctl restart efinder
LOG "Done. Previous database kept at $DB_PATH.bak"
