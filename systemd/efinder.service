[Unit]
Description=eFinder plate-solving telescope finder (olive)
Documentation=https://github.com/mconsidine/eFinder_cli
After=network.target

[Service]
Type=simple
User=efinder
Group=efinder
WorkingDirectory=/opt/efinder
Environment=PYTHONUNBUFFERED=1
Environment=EFINDER_CONFIG=/etc/efinder/efinder.conf

# Create /run/efinder owned by efinder:efinder for the maintenance
# Unix socket.
RuntimeDirectory=efinder
RuntimeDirectoryMode=0750

# Clean up stale IPC left by an unclean exit before starting. The '-' prefix
# makes a failure non-fatal (e.g. nothing to remove). The shell glob needs a
# shell, so these run via /bin/sh -c.
ExecStartPre=-/bin/sh -c 'rm -f /dev/shm/efinder_frame_*'
ExecStartPre=-/bin/sh -c 'rm -f /run/efinder/maint.sock'

ExecStart=/opt/efinder/venv/bin/python -m efinder.efinder_main

Restart=on-failure
RestartSec=5

NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/efinder /etc/efinder /run/efinder

[Install]
WantedBy=multi-user.target
