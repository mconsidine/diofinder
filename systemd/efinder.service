[Unit]
Description=eFinder plate-solving telescope finder (combo: cedar+tetra3rs)
Documentation=https://github.com/mconsidine/eFinder_cli
After=cedar-detect.service network.target
# Wants (not Requires): efinder starts even if cedar-detect is absent.
# The cedar backend will fail per-solve until cedar-detect is running;
# the tetra backend works without it entirely.
Wants=cedar-detect.service

[Service]
Type=simple
User=efinder
Group=efinder
WorkingDirectory=/opt/efinder
Environment=PYTHONUNBUFFERED=1
Environment=EFINDER_CONFIG=/etc/efinder/efinder.conf

# Create /run/efinder owned by efinder:efinder for the maintenance
# Unix socket.
RuntimeDirectory=efinder
RuntimeDirectoryMode=0750

ExecStart=/opt/efinder/venv/bin/python -m efinder.efinder_main

Restart=on-failure
RestartSec=5

NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/efinder /etc/efinder /run/efinder

[Install]
WantedBy=multi-user.target
