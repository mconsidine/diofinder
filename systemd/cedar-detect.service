[Unit]
Description=Cedar-detect star centroid extraction gRPC server
Documentation=https://github.com/smroid/cedar-detect
After=network.target

[Service]
Type=simple
User=efinder
Group=efinder

ExecStart=/usr/local/bin/cedar-detect-server --port 50051

Restart=on-failure
RestartSec=2

# Pin cedar-detect to CPU 2. The solver (caller) runs on CPU 3. Keeping them
# on separate cores eliminates context-switch contention during the gRPC call
# that happens on every frame -- previously both ends competed for CPU 3.
CPUAffinity=2
Nice=-5

# Hardening -- kept intentionally loose for a cross-compiled Rust binary
# on first deployment. Tighten after confirming stable operation.
NoNewPrivileges=true
# NOT using ProtectSystem=strict -- cross-compiled binary may need paths
# we haven't enumerated. Use 'full' (protects /usr /boot read-only) which
# is less aggressive than 'strict' (everything read-only).
ProtectSystem=full
ProtectHome=true
# /dev/shm access: cedar-detect uses POSIX shared memory (shm_open) to
# read image frames directly from the eFinder process, bypassing a
# 730 KB gRPC serialization per frame. Do NOT remove this.
ReadWritePaths=/dev/shm

[Install]
WantedBy=multi-user.target
