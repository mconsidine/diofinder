[Unit]
Description=eFinder USB serial ACM gadget (configfs)
# sys.mount provides /sys/kernel/config (configfs) and /sys/class/udc.
# systemd-modules-load ensures libcomposite/usb_f_acm/u_serial are present.
After=systemd-modules-load.service sys.mount
Wants=systemd-modules-load.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/efinder-gadget-connect

[Install]
WantedBy=multi-user.target
