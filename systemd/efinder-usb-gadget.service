[Unit]
Description=eFinder USB serial ACM gadget (configfs)
# systemd-modules-load ensures dwc2/libcomposite/usb_f_acm/u_serial are loaded.
# sys.mount provides /sys (sysfs); efinder-gadget-connect mounts configfs itself.
After=systemd-modules-load.service sys.mount
Wants=systemd-modules-load.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/efinder-gadget-connect
# Retry if the UDC isn't found on first attempt (can happen on first boot
# when Pi OS first-run scripts are holding USB driver locks or when dwc2
# was not included in the initramfs and takes extra time to bind).
Restart=on-failure
RestartSec=15s
StartLimitIntervalSec=120s
StartLimitBurst=4

[Install]
WantedBy=multi-user.target
